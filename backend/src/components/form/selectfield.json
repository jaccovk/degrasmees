{
  "collectionName": "components_form_selectfields",
  "info": {
    "displayName": "Selectfield",
    "icon": "bulletList"
  },
  "options": {},
  "attributes": {
    "label": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "required": true,
      "regex": "^[a-zA-Z_-]+$"
    },
    "placeholder": {
      "type": "string"
    },
    "help": {
      "type": "string"
    },
    "required": {
      "type": "boolean",
      "default": false
    },
    "error": {
      "type": "string"
    },
    "disabled": {
      "type": "boolean",
      "default": false
    },
    "size": {
      "type": "enumeration",
      "enum": [
        "half",
        "full"
      ],
      "default": "full",
      "required": true
    },
    "options": {
      "type": "component",
      "repeatable": true,
      "component": "elements.option"
    }
  }
}
